# Variables of one key holder process (key_holder/README.md "Configuration").
# Copy to .env for local use. Never commit a scalar, an API key or a password.
# kh1 and kh2 each have their own file: their own HOLDER_ID, scalar and database.

HOLDER_ID=kh1
ACTIVE_KEY_VERSION=1
PORT=8301
BIND_HOST=127.0.0.1
DAILY_ELEMENT_CAP=1000000

# Secret: the standard base64 of this holder's 32 byte scalar. Read by serve only.
OPRF_SCALAR_B64=

# Secret: postgresql://{database}_app:PASSWORD@HOST:PORT/{database}. Read by serve and db provision.
DATABASE_URL=

# Secret: postgresql://{database}_owner:PASSWORD@HOST:PORT/{database}. Read by db provision and db migrate.
MIGRATION_DATABASE_URL=

# Secret: a PostgreSQL superuser URL. Read by db provision only.
PG_ADMIN_URL=

# A JSON object of member id to the SHA-256 hex of that member's API key. Read by db migrate only.
MEMBER_KEY_HASHES=
